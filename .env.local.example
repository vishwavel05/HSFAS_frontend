# Base URL of the Django backend (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Login endpoint is NOT documented in the backend README (Backend_final.md).
# The README only documents /api/enrollments/, /api/attendance/, and
# /api/attendance/update/. This app calls the endpoint below for Sign In;
# point it at whatever auth endpoint your Django backend actually exposes
# (e.g. a DRF TokenAuth view, SimpleJWT, or session login) once one exists.
NEXT_PUBLIC_AUTH_LOGIN_ENDPOINT=/api/auth/login/
